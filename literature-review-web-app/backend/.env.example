# =============================================================================
# Literature Review Web App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Never commit .env to version control.
# =============================================================================


# === Google AI / Gemini ===

# REQUIRED — Gemini API key used for all LLM calls.
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here


# === Academic Search APIs ===

# OPTIONAL — IEEE Xplore full-text search API key.
# Register at: https://developer.ieee.org
# Leave empty to skip IEEE Xplore as a search source.
IEEE_API_KEY=

# OPTIONAL — Semantic Scholar API key.
# Improves rate limits for Semantic Scholar requests.
# Register at: https://api.semanticscholar.org
# Leave empty to use the unauthenticated (lower-rate) endpoint.
SEMANTIC_SCHOLAR_API_KEY=

# OPTIONAL — SerpApi key for reliable Google Scholar search.
# Register at: https://serpapi.com
# If absent the application falls back to the `scholarly` library,
# which may be rate-limited or blocked by Google.
SERPAPI_KEY=


# === Infrastructure ===

# OPTIONAL — Redis connection URL used for job-result caching.
# Falls back to an in-memory cache when Redis is unavailable.
# Example: redis://localhost:6379
#          redis://:password@redis-host:6379/0
REDIS_URL=redis://localhost:6379

# OPTIONAL — Persistent storage connection URL (PostgreSQL recommended).
# Leave empty to run without a persistent database (in-memory only).
# Example: postgresql+asyncpg://user:password@localhost:5432/litreview
DATABASE_URL=


# === Observability ===

# OPTIONAL — Minimum log level emitted by the application.
# Accepted values: DEBUG | INFO | WARNING | ERROR
# Default: INFO
LOG_LEVEL=INFO


# === HTTP / CORS ===

# OPTIONAL — JSON array of origins that are allowed to call the API.
# Add your frontend dev-server URL(s) here.
# Default: ["http://localhost:3000","http://localhost:5173"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]


# === Runtime ===

# OPTIONAL — Maximum number of literature-review pipeline jobs that may
# run concurrently. Increase on machines with more CPU/memory headroom.
# Default: 10
MAX_CONCURRENT_JOBS=10

# OPTIONAL — Application version string surfaced in health-check responses.
# Default: 1.0.0
APP_VERSION=1.0.0

# OPTIONAL — Deployment environment identifier.
# Accepted values: development | staging | production
# Default: development
ENVIRONMENT=development
